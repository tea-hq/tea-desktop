{
  "extends": "./tsconfig.app.json",
  "include": [
    "env.d.ts",
    "interface-extensions.d.ts",
    "components.d.ts",
    "auto-imports.d.ts",
    "src/**/*",
    "packages/runner/src/protocol.ts",
    "packages/runner/src/runner.ts",
    "packages/runner/src/acp.ts",
    "packages/runner/src/defaults.ts",
    "packages/runner/src/logger.ts",
    "scripts/**/*.test.ts",
    "tests/unit/**/*.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo",
    "types": ["node"],
    "ignoreDeprecations": "6.0"
  }
}

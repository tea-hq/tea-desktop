    "vue": "^3.5.30",
    "vue-i18n": "^11.4.8",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@egoist/tailwindcss-icons": "^1.9.2",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify/types": "^2.0.0",
